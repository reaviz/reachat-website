{
  "name": "reachat-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "sync:stories": "node scripts/copy-stories.mjs && node scripts/generate-story-sources.mjs",
    "predev": "pnpm run sync:stories",
    "dev": "next dev",
    "prebuild": "pnpm run sync:stories",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "build:cloudflare": "pnpm run build && npx @cloudflare/next-on-pages",
    "preview": "npx wrangler pages dev .vercel/output/static",
    "postinstall": "pnpm run sync:stories",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "motion": "^11.18.0",
    "next": "^15.5.18",
    "nextra": "^4.6.1",
    "posthog-js": "^1.131.4",
    "reablocks": "^10.3.0",
    "reablocks-docs-theme": "2.3.3",
    "reachat": "3.3.0",
    "react": "^19.1.0",
    "react-compiler-runtime": "^19.1.0-rc.2",
    "react-dom": "^19.1.0",
    "reaviz": "^16.1.4",
    "sharp": "^0.33.3",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "^15.5.18",
    "pagefind": "^1.3.0",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "prismjs": "^1.30.0",
      "postcss": "^8.5.10"
    }
  }
}
